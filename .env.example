# Database
HEDGE_DATABASE_URL=postgresql+asyncpg://hedgefund:localdev@localhost:5433/hedgefund

# Execution mode: "paper" or "live"
HEDGE_EXECUTION_MODE=paper

# Paper trading configuration
HEDGE_PAPER_SLIPPAGE_BPS=5.0
HEDGE_PAPER_COMMISSION_PER_TRADE=0.0

# Debug mode (enables SQL echo, verbose logging)
HEDGE_DEBUG=false
